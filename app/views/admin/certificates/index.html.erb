<div class="m-5 border-2 rounded-md shadow-sm">
	<div class="m-2">
		<div class="px-4 sm:px-6 lg:px-8">
			<div class="sm:flex sm:items-center">
				<div class="sm:flex-auto">
					<h1 class="text-base font-semibold leading-6 text-gray-900">Certificados</h1>
					<p class="mt-2 text-sm text-gray-700">Lista de todos os certificados criados.</p>
				</div>
									<div class="mt-4 flex flex-col gap-3 sm:ml-16 sm:mt-0 sm:flex-row sm:items-end">
										<div>
											<span class="block text-xs font-medium text-gray-700">Filtrar por situação</span>
											<div class="mt-1 flex flex-wrap gap-2">
												<% status_filters = [
													["Todos", nil, "bg-gray-100 text-gray-700 ring-gray-600/20"],
													["Certificado válido", "active", "bg-emerald-50 text-emerald-700 ring-emerald-600/20"],
													["Certificado expirado", "expired", "bg-amber-50 text-amber-700 ring-amber-600/20"],
													["Certificado revogado", "revoked", "bg-red-50 text-red-700 ring-red-600/20"]
												] %>
												<% status_filters.each do |label, status, color_classes| %>
													<%= link_to label, admin_certificates_path(status: status), class: "inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset hover:opacity-80 #{color_classes} #{@status == status ? 'ring-2 ring-offset-1' : ''}" %>
												<% end %>
											</div>
										</div>
										<%= button_to "Atualizar expirados", expire_admin_certificates_path, method: :patch, params: { status: @status }, class: "rounded-md bg-amber-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 hover:cursor-pointer" %>
										<%= link_to "Novo certificado", new_admin_certificate_path, class: "rounded-md bg-red-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
									</div>
			</div>
			<div class="mt-8 flow-root">
				<div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
					<div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
						<table class="min-w-full divide-y divide-gray-300">
							<thead>
								<tr>
									<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-3">Aluno</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Curso</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Código</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Situação</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Emitido em</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Válido até</th>
									<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-3">
										<span class="sr-only">Editar</span>
									</th>
								</tr>
							</thead>
							<tbody class="bg-white">
								<% if @certificates.any? %>
									<% @certificates.each do |certificate| %>
										<% status_styles = {
											"active" => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
											"expired" => "bg-amber-50 text-amber-700 ring-amber-600/20",
											"revoked" => "bg-red-50 text-red-700 ring-red-600/20"
										} %>
										<% status = certificate.effective_status.to_s %>
										<tr class="even:bg-gray-50">
											<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-3"><%= certificate.user.name %></td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= certificate.course.name %></td>
											<td class="whitespace-nowrap px-3 py-4 text-sm font-medium"><%= link_to certificate.code, certificate_path(certificate.code), class: "text-red-600 hover:text-red-900" %></td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
												<span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= status_styles.fetch(status, "bg-gray-50 text-gray-700 ring-gray-600/20") %>"><%= t("certificates.status.#{status}") %></span>
											</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= l certificate.issued_at.to_date, format: :long %></td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= l certificate.expires_at.to_date, format: :long %></td>
																							<td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-3">
																								<% if (whatsapp_url = certificate_whatsapp_url(certificate)) %>
																									<%= link_to whatsapp_url, target: "_blank", rel: "noopener", title: "Abrir o WhatsApp com uma mensagem pronta para o aluno", aria: { label: "Compartilhar certificado pelo WhatsApp" }, class: "mr-3 inline-flex items-center gap-1 rounded-md border border-green-200 px-2 py-1 text-green-600 hover:border-green-400 hover:bg-green-50" do %>
																										<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
																											<path stroke-linecap="round" stroke-linejoin="round" d="M6.5 18.5 5 21l3.2-.9A8.5 8.5 0 1 0 6.5 18.5Z" />
																											<path stroke-linecap="round" stroke-linejoin="round" d="M9 10.2c.4 2 1.8 3.4 3.8 3.8.5.1 1-.1 1.3-.5l.5-.7c.2-.3.1-.7-.2-.9l-1.1-.6c-.3-.2-.7-.1-.9.2l-.3.4c-.8-.3-1.4-.9-1.7-1.7l.4-.3c.3-.2.4-.6.2-.9l-.6-1.1c-.2-.3-.6-.4-.9-.2l-.7.5c-.4.3-.6.8-.5 1.3Z" />
																											</svg>
																											<span>WhatsApp</span>
																										<% end %>
																								<% end %>
																								<%= link_to pdf_admin_certificate_path(certificate), title: "Baixar o certificado completo em PDF", aria: { label: "Baixar certificado em PDF" }, class: "inline-flex items-center rounded-md border border-red-200 px-2 py-1 text-red-600 hover:border-red-400 hover:bg-red-50" do %>
																									<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
																										<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2" />
																										</svg>
																									<% end %>
																								<%= link_to "Editar", edit_admin_certificate_path(certificate), class: "text-red-600 hover:text-red-900" %>
																							</td>
										</tr>
									<% end %>
								</tbody>
							<% else %>
								<tr class="even:bg-gray-50">
									<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-3" colspan="7">Nenhum certificado criado.</td>
								</tr>
							<% end %>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
