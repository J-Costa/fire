<div class="m-10 border p-4 shadow-sm">
  <%= form_for [:admin, @certificate], html: { class: "space-y-12 p-4" } do |f| %>
    <div class="grid grid-cols-1 gap-x-8 gap-y-10 border-b border-gray-900/10 pb-12 md:grid-cols-3">
      <div>
        <h2 class="text-base font-semibold leading-7 text-gray-900"><%= title %></h2>
        <p class="mt-1 text-sm leading-6 text-gray-600"><%= description %></p>
      </div>
      <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2">
        <div class="col-span-full">
          <%= label :enrollment_id, "Matrícula", class: "block text-sm font-medium leading-6 text-gray-900" %>
          <div class="mt-2">
            <% if @enrollments.any? %>
              <%= f.collection_select :enrollment_id, @enrollments, :id, ->(enrollment) { "#{enrollment.user.name} - #{enrollment.course.name}" }, { prompt: "Selecione o aluno e o curso" }, class: "block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6", required: true %>
            <% else %>
              <p class="text-sm leading-6 text-gray-600">Nenhuma matrícula encontrada. Cadastre uma matrícula antes de criar um certificado.</p>
            <% end %>
          </div>
        </div>
        <div class="sm:col-span-3">
          <%= label :status, "Situação", class: "block text-sm font-medium leading-6 text-gray-900" %>
          <div class="mt-2">
            <%= f.select :status, Certificate.statuses.keys.map { |status| [t("certificates.status.#{status}"), status] }, {}, class: "block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6", required: true %>
          </div>
        </div>
        <div class="sm:col-span-3">
          <%= label :issued_at, "Emitido em", class: "block text-sm font-medium leading-6 text-gray-900" %>
          <div class="mt-2">
            <%= f.datetime_local_field :issued_at, class: "block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6", required: true %>
          </div>
        </div>
        <div class="sm:col-span-3">
          <%= label :expires_at, "Válido até", class: "block text-sm font-medium leading-6 text-gray-900" %>
          <div class="mt-2">
            <%= f.datetime_local_field :expires_at, class: "block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6", required: true %>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-6 flex items-center justify-end gap-x-6">
      <% if @certificate.persisted? %>
        <%= link_to pdf_admin_certificate_path(@certificate), title: "Baixar o certificado completo em PDF", aria: { label: "Baixar certificado em PDF" }, class: "inline-flex items-center gap-2 rounded-md border border-red-200 px-3 py-2 text-sm font-semibold leading-6 text-red-600 hover:border-red-400 hover:bg-red-50" do %>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2" />
          </svg>
          <span>PDF</span>
        <% end %>
        <% if (whatsapp_url = certificate_whatsapp_url(@certificate)) %>
          <%= link_to whatsapp_url, target: "_blank", rel: "noopener", title: "Abrir o WhatsApp com uma mensagem pronta para o aluno", aria: { label: "Compartilhar certificado pelo WhatsApp" }, class: "inline-flex items-center gap-2 rounded-md border border-green-200 px-3 py-2 text-sm font-semibold leading-6 text-green-600 hover:border-green-400 hover:bg-green-50" do %>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 18.5 5 21l3.2-.9A8.5 8.5 0 1 0 6.5 18.5Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 10.2c.4 2 1.8 3.4 3.8 3.8.5.1 1-.1 1.3-.5l.5-.7c.2-.3.1-.7-.2-.9l-1.1-.6c-.3-.2-.7-.1-.9.2l-.3.4c-.8-.3-1.4-.9-1.7-1.7l.4-.3c.3-.2.4-.6.2-.9l-.6-1.1c-.2-.3-.6-.4-.9-.2l-.7.5c-.4.3-.6.8-.5 1.3Z" />
            </svg>
            <span>WhatsApp</span>
          <% end %>
        <% end %>
      <% end %>
      <%= link_to "Cancelar", admin_certificates_path, class: "text-sm font-semibold leading-6 text-gray-900" %>
      <%= f.submit class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 hover:cursor-pointer" %>
    </div>
  <% end %>
</div>
