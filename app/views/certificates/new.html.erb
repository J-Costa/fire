<% content_for :title, "Validar certificado | Krypton treinamentos" %>

<section class="bg-gray-50 px-6 py-16 sm:px-10 lg:px-16">
  <div class="mx-auto max-w-xl rounded-lg bg-white p-8 shadow-sm ring-1 ring-gray-100 sm:p-12">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-gray-900">Validar certificado</h1>
      <p class="mt-3 text-gray-600">Informe o código do certificado para consultar sua autenticidade e situação.</p>
    </div>

    <%= form_with url: certificates_path, scope: :certificate, method: :post, data: { turbo: false }, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= form.label :code, "Código do certificado", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "off", class: "mt-2 w-full rounded-md border border-gray-300 p-3 uppercase shadow-sm focus:border-red-500 focus:ring-2 focus:ring-red-500" %>
      </div>
      <%= form.submit "Verificar certificado", class: "w-full rounded-md bg-red-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-red-700 focus:outline-hidden focus:ring-3 focus:ring-red-300" %>
    <% end %>
  </div>
</section>