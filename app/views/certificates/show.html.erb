<% content_for :title, "Validação de certificado | Krypton treinamentos" %>

<section class="bg-gray-50 px-6 py-16 sm:px-10 lg:px-16">
  <div class="mx-auto max-w-xl rounded-lg bg-white p-8 shadow-sm ring-1 ring-gray-100 sm:p-12">
    <% if @certificate %>
      <% valid = @certificate.valid_certificate? %>
      <% status_styles = {
        "active" => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
        "expired" => "bg-amber-50 text-amber-700 ring-amber-600/20",
        "revoked" => "bg-red-50 text-red-700 ring-red-600/20"
      } %>
      <% status_style = status_styles.fetch(@certificate.status, "bg-gray-50 text-gray-700 ring-gray-600/20") %>

      <div class="text-center">
        <span class="inline-flex items-center rounded-full px-4 py-2 text-sm font-semibold ring-1 ring-inset <%= status_style %>">
          <%= t("certificates.status.#{@certificate.status}") %>
        </span>
        <h1 class="mt-5 text-3xl font-bold text-gray-900"><%= @certificate.user.name %></h1>
        <%= link_to @certificate.course.name, course_path(@certificate.course), class: "mt-2 inline-block text-lg font-medium text-red-600 hover:underline" %>
        <p class="mt-3 text-sm text-gray-600"><%= t("certificates.labels.code") %>: <strong><%= @certificate.code %></strong></p>
      </div>

      <dl class="mt-8 divide-y divide-gray-100 border-y border-gray-100">
        <div class="flex justify-between gap-4 py-4">
          <dt class="text-gray-600"><%= t("certificates.labels.student") %></dt>
          <dd class="font-medium text-right text-gray-900"><%= @certificate.user.name %></dd>
        </div>
        <div class="flex justify-between gap-4 py-4">
          <dt class="text-gray-600"><%= t("certificates.labels.course") %></dt>
          <dd class="text-right"><%= link_to @certificate.course.name, course_path(@certificate.course), class: "font-medium text-red-600 hover:underline" %></dd>
        </div>
        <div class="flex justify-between gap-4 py-4">
          <dt class="text-gray-600"><%= t("certificates.labels.status") %></dt>
          <span class="inline-flex items-center rounded-full px-4 py-2 text-sm font-semibold ring-1 ring-inset <%= status_style %>"><%= t("certificates.status.#{@certificate.status}") %></span>
        </div>
        <div class="flex justify-between gap-4 py-4">
          <dt class="text-gray-600"><%= t("certificates.labels.issued_at") %></dt>
          <dd class="font-medium text-gray-900"><%= l(@certificate.issued_at.to_date) %></dd>
        </div>
        <div class="flex justify-between gap-4 py-4">
          <dt class="text-gray-600"><%= t("certificates.labels.expires_at") %></dt>
          <dd class="font-medium text-gray-900"><%= l(@certificate.expires_at.to_date) %></dd>
        </div>
      </dl>

      <% if @certificate.course.description.present? %>
        <div class="mt-8 rounded-md bg-gray-50 p-5">
          <h2 class="font-semibold text-gray-900"><%= t("certificates.labels.about_course") %></h2>
          <p class="mt-2 text-sm leading-6 text-gray-600"><%= @certificate.course.description %></p>
        </div>
      <% end %>
    <% else %>
      <div class="text-center">
        <h1 class="text-3xl font-bold text-gray-900"><%= t("certificates.not_found.title") %></h1>
        <p class="mt-3 text-gray-600"><%= t("certificates.not_found.description") %></p>
      </div>
    <% end %>

    <div class="mt-8 text-center">
      <%= link_to t("certificates.actions.validate_another"), new_certificate_path, class: "text-sm font-medium text-red-600 hover:underline" %>
    </div>
  </div>
</section>